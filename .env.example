# Process-environment names only; no automatic dotenv loading.
APP_ENV=local
DATABASE_URL=
P5_DB_SCOPE=beta
# Explicit exact non-local database host (container/private networking only).
P5_DATABASE_HOST=
PORT=8000
GMAIL_SENDER=sender@example.invalid
GMAIL_OAUTH_MODE=desktop
GOOGLE_CLIENT_JSON_PATH=
# Headless mode uses deployment secrets instead of a local JSON file.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Credentials are supplied through the masked launcher or secure environment.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Optional destructive tests: explicitly disposable p5_test_* database only.
P5_TEST_DATABASE_URL=
